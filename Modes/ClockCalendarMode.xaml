<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TurzxDisplay.Modes.ClockCalendarMode"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TurzxDisplay.Controls"
    Width="800" Height="480">

    <Grid Background="#E9EFF7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Clock card (left) -->
        <controls:SoftCard Grid.Column="0" CornerRadius="24" Background="#E9EFF7" BorderBrush="#59FFFFFF">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock x:Name="WeekdayText" FontSize="27" Foreground="#7687A3"
                           FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <TextBlock x:Name="TimeText" FontSize="128" FontWeight="SemiBold" Foreground="#2E3D59"
                               FontFamily="Segoe UI Variable Display"/>
                    <TextBlock x:Name="SecondsText" FontSize="38" Foreground="#8AA0D8" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display" VerticalAlignment="Bottom" Margin="0,0,0,22"/>
                </StackPanel>
                <TextBlock x:Name="DateText" FontSize="26" Foreground="#7687A3" HorizontalAlignment="Center"
                           FontFamily="Segoe UI Variable Display"/>
                <Border CornerRadius="14" Background="#F2F6FC" Width="150" Height="7" Margin="0,14,0,0"
                        BorderBrush="#4DFFFFFF" BorderThickness="1">
                    <Border CornerRadius="8" Background="#8AA0D8" x:Name="PulseBar" HorizontalAlignment="Left" Width="40"/>
                </Border>
            </StackPanel>
        </controls:SoftCard>

        <!-- Calendar card (right) -->
        <controls:SoftCard Grid.Column="2" CornerRadius="24" Background="#E9EFF7" BorderBrush="#59FFFFFF">
            <Grid Margin="26,22,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="MonthTitle" FontSize="28" FontWeight="SemiBold" Foreground="#2E3D59"
                               FontFamily="Segoe UI Variable Display" VerticalAlignment="Center"/>
                    <Border x:Name="TodayBadge" CornerRadius="12" Background="#8AA0D8" Padding="12,4"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TodayBadgeText" FontSize="17" Foreground="White"
                                   FontFamily="Segoe UI Variable Display"/>
                    </Border>
                </Grid>

                <Grid x:Name="WeekdayHeader" Grid.Row="2"/>
                <Grid x:Name="DaysGrid" Grid.Row="4"/>
            </Grid>
        </controls:SoftCard>
    </Grid>
</UserControl>
