<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TurzxDisplay.Modes.WeatherMode"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TurzxDisplay.Controls"
    Width="800" Height="480">

    <Grid Background="#E9EFF7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header: city / condition / updated | current emoji + temp -->
        <controls:SoftCard Grid.Row="0" Margin="12,12,12,6" CornerRadius="18" Padding="22,10"
                           Background="#E9EFF7" BorderBrush="#59FFFFFF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="CityText" FontSize="27" FontWeight="SemiBold" Foreground="#2E3D59"
                               FontFamily="Segoe UI Variable Display"/>
                    <TextBlock x:Name="CondText" FontSize="17" Foreground="#7687A3"
                               FontFamily="Segoe UI Variable Display"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="CurEmoji" FontSize="40" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CurTempText" FontSize="52" FontWeight="SemiBold" Foreground="#2E3D59"
                               FontFamily="Segoe UI Variable Display" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdatedText" FontSize="12" Foreground="#9AA9C2" VerticalAlignment="Bottom"
                               Margin="0,0,0,8" FontFamily="Segoe UI Variable Display"/>
                </StackPanel>
            </Grid>
        </controls:SoftCard>

        <!-- info strip: wind / humidity / AQI / sun / moon / warning -->
        <controls:SoftCard x:Name="InfoStrip" Grid.Row="1" Margin="12,6,12,6" CornerRadius="16" Padding="20,7"
                           Background="#E9EFF7" BorderBrush="#59FFFFFF">
            <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                <Border x:Name="WarnChip" CornerRadius="9" Background="#E0655A" Padding="9,3" Visibility="Collapsed">
                    <TextBlock x:Name="WarnText" FontSize="13" FontWeight="SemiBold" Foreground="White"
                               FontFamily="Segoe UI Variable Display"/>
                </Border>
                <TextBlock x:Name="WindText" FontSize="14" Foreground="#5B6C8F" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display"/>
                <TextBlock x:Name="HumText" FontSize="14" Foreground="#5B6C8F" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display"/>
                <Border x:Name="AqiChip" CornerRadius="9" Padding="9,3" Visibility="Collapsed">
                    <TextBlock x:Name="AqiText" FontSize="13" FontWeight="SemiBold" Foreground="White"
                               FontFamily="Segoe UI Variable Display"/>
                </Border>
                <TextBlock x:Name="SunText" FontSize="14" Foreground="#5B6C8F" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display"/>
                <TextBlock x:Name="MoonText" FontSize="14" Foreground="#5B6C8F" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display"/>
            </StackPanel>
        </controls:SoftCard>

        <!-- content: 24h curve / 7-day columns -->
        <controls:SoftCard Grid.Row="2" Margin="12,6,12,12" CornerRadius="18" Padding="16,10"
                           Background="#E9EFF7" BorderBrush="#59FFFFFF">
            <Grid>
                <!-- 24 hour view -->
                <StackPanel x:Name="HourView" Spacing="2">
                    <Canvas x:Name="ChartCanvas" Height="128"/>
                    <Grid x:Name="HourGrid"/>
                </StackPanel>

                <!-- 7 day view -->
                <Grid x:Name="WeekView" Visibility="Collapsed"/>

                <!-- status while loading / error / unconfigured -->
                <TextBlock x:Name="StatusText" Visibility="Collapsed" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="20" Foreground="#7687A3"
                           FontFamily="Segoe UI Variable Display"/>
            </Grid>
        </controls:SoftCard>
    </Grid>
</UserControl>
