<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TurzxDisplay.Modes.MusicMode"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TurzxDisplay.Controls"
    Width="800" Height="480">

    <Grid Background="#2B2937">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- track card: cover | title / artist / album / progress -->
        <controls:SoftCard Grid.Row="0" Margin="12,12,12,6" CornerRadius="18" Padding="24"
                           Background="#333042" BorderBrush="#26FFFFFF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="188" Height="188" Margin="0,0,26,0">
                    <Border CornerRadius="16" Background="#3D3A4E">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="52"
                                   Foreground="#6B6590" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="CoverHost" CornerRadius="16" Visibility="Collapsed">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,188,188"/>
                        </Border.Clip>
                        <Image x:Name="CoverImg" Stretch="UniformToFill"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <Border x:Name="SrcBadge" CornerRadius="9" Background="#8B80E8" Padding="10,3"
                            HorizontalAlignment="Left" Margin="0,0,0,6" Visibility="Collapsed">
                        <TextBlock x:Name="SrcText" Text="" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                   FontFamily="Segoe UI Variable Display"/>
                    </Border>
                    <Grid x:Name="TitleHost" Height="40">
                        <Canvas>
                            <TextBlock x:Name="TitleText" Text="未在播放" FontSize="27" FontWeight="SemiBold" Foreground="#F0EEF8"
                                       FontFamily="Segoe UI Variable Display">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="TitleShift"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </Grid>
                    <Grid x:Name="ArtistHost" Height="26">
                        <Canvas>
                            <TextBlock x:Name="ArtistText" Text="" FontSize="18" Foreground="#A9A4C4"
                                       FontFamily="Segoe UI Variable Display">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="ArtistShift"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </Grid>
                    <TextBlock x:Name="AlbumText" Text="" FontSize="14" Foreground="#8B86AD"
                               TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable Display"/>

                    <Grid Margin="0,14,0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Height="10" CornerRadius="5" Background="#454158" Margin="0,0,0,6">
                            <Border x:Name="ProgBar" Height="10" CornerRadius="5" Background="#8B80E8"
                                    HorizontalAlignment="Left" Width="0"/>
                        </Border>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="PosText" Text="--:--" FontSize="12" Foreground="#A9A4C4"
                                       FontFamily="Segoe UI Variable Display"/>
                            <TextBlock x:Name="DurText" Text="--:--" FontSize="12" Foreground="#8B86AD"
                                       HorizontalAlignment="Right" FontFamily="Segoe UI Variable Display"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>
        </controls:SoftCard>

        <!-- lyrics card -->
        <controls:SoftCard Grid.Row="1" Margin="12,6,12,12" CornerRadius="18" Padding="28,12"
                           Background="#333042" BorderBrush="#26FFFFFF">
            <Grid>
                <StackPanel VerticalAlignment="Center" Spacing="7">
                    <TextBlock x:Name="PrevLine" Text="" FontSize="15" Foreground="#7E7899" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable Display"/>
                    <TextBlock x:Name="CurLine" Text="" FontSize="23" FontWeight="SemiBold" Foreground="#F0EEF8"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               MaxLines="2" FontFamily="Segoe UI Variable Display"/>
                    <TextBlock x:Name="NextLine" Text="" FontSize="15" Foreground="#7E7899" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable Display"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="#8B86AD" TextWrapping="Wrap" TextAlignment="Center"
                           FontFamily="Segoe UI Variable Display"/>
            </Grid>
        </controls:SoftCard>
    </Grid>
</UserControl>
